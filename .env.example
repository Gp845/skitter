OG_BASE_URL=https://router-api.0g.ai/v1
STT_MODEL=gemini-3.5-flash-lite
VLM_MODEL=gemini-3.5-flash-lite

# 0G Storage + Chain (Galileo testnet, chain 16602). Make a wallet: node storage/make_wallet.mjs, fund at faucet.0g.ai
STORAGE_PRIVATE_KEY=0x...
STORAGE_RPC=https://evmrpc-testnet.0g.ai
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
REGISTRY_ADDRESS=0x7d3dA1F5e4358D4b71bCB5fb4465613DEB1161d6

# safety + spend limits
LEASE_S=3
MAX_CHECKPOINTS=6
BUDGET_USD=3.0
# 64 hex chars; seals episode bundles before upload (no key = no upload). Back it up: without it, episodes can't be read.
EPISODE_KEY=
# control room + recordings login; empty = a random one is printed at startup
SKITTER_PASSWORD=
