# 0G Compute Router (OpenAI-compatible) - key from https://pc.0g.ai
OG_API_KEY=sk-...
OG_BASE_URL=https://router-api.0g.ai/v1
OG_MGMT_KEY=                   # optional mk- key (account:read): shows your 0G credit balance on /account
STT_MODEL=gemini-3.5-flash-lite
VLM_MODEL=gemini-3.5-flash-lite

# 0G Storage + Chain (Galileo testnet, chain 16602). Make a wallet: node storage/make_wallet.mjs, fund at faucet.0g.ai
STORAGE_PRIVATE_KEY=0x...
STORAGE_RPC=https://evmrpc-testnet.0g.ai
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
REGISTRY_ADDRESS=0x7d3dA1F5e4358D4b71bCB5fb4465613DEB1161d6

# safety + spend limits
LEASE_S=3
MAX_CHECKPOINTS=6
BUDGET_USD=3.0
# 64 hex chars; seals episode bundles before upload (no key = no upload). Back it up: without it, episodes can't be read.
EPISODE_KEY=
# control room + recordings login; empty = a random one is printed at startup
SKITTER_PASSWORD=
# comma-separated wallet addresses allowed to log in by signing (0G wallet login); empty = wallet login off
OWNER_WALLETS=
# extra hostnames allowed when deployed behind a reverse proxy, e.g. skitter.example.com (localhost is always allowed)
SKITTER_HOSTS=

# hub mode (python hub.py): one robot per wallet account
# 64 hex chars; seals every account's robot wallet key, EPISODE_KEY and 0G API key. Empty = generated into .env on
# first start. Back it up: without it no account can be opened (the hub refuses to start with a wrong one).
ACCOUNTS_KEY=
MAX_ROBOTS=3
# stop a robot after this many seconds without requests from its control room
ROBOT_IDLE_S=900
# data dir of a robot (episodes, feed clips, map.json); the hub sets it per account. Default: episodes/
SKITTER_HOME=
